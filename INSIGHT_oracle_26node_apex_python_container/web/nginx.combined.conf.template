# Template for the COMBINED image's nginx config. Rendered to
# /etc/nginx/conf.d/default.conf at container start by docker-entrypoint.py,
# which substitutes the double-underscore tokens below from environment
# variables. It is a template rather than a static file because the ORDS
# host and API key are environment-specific and must never be baked into
# an image.
#
# The web/Dockerfile image uses web/nginx.standalone.conf instead: it is
# based on nginx:alpine and has no interpreter available to render this.
#
# Substituted tokens:
#   __RESOLVER__        DNS server, read from /etc/resolv.conf at startup
#   __ORDS_BASE_URL__   scheme://host of the ORDS server, no path, may be empty
#   __ORDS_API_KEY__    api_key for the insight module, may be empty

server {
    listen 8000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ---- ORDS reverse proxy -------------------------------------------
    # Lets the browser reach the insight REST module through this
    # origin instead of calling the database host directly. Two reasons:
    #
    #  1. Same-origin, so there is no CORS preflight to configure on ORDS.
    #  2. The api_key is attached here, server-side. The module takes it as
    #     a query parameter, so a browser-side key would be readable in
    #     page source, the network tab, and every access log in between.
    #     The front end sends no key at all; this adds it in transit.
    #
    # proxy_pass uses a variable deliberately. With a literal hostname
    # nginx resolves at config-parse time and REFUSES TO START if the name
    # does not resolve -- which is exactly how this container died once
    # before. Going through a variable defers resolution to request time,
    # so a misconfigured or unreachable ORDS host degrades to a 502 on
    # /ords/ while the questionnaire and matrix keep being served.
    location /ords/ {
        resolver __RESOLVER__ valid=30s ipv6=off;

        set $ords_base "__ORDS_BASE_URL__";
        set $ords_key  "__ORDS_API_KEY__";

        # Unconfigured is a normal state (the UI works without ORDS), so
        # answer honestly rather than emitting a confusing 502.
        if ($ords_base = "") {
            return 503 '{"ok":false,"error":"ORDS_BASE_URL is not set on this container"}';
        }

        set $fwd_args $args;
        if ($ords_key != "") {
            set $fwd_args "$args&api_key=$ords_key";
        }

        proxy_pass $ords_base$uri?$fwd_args;

        # Needed for TLS to the ORDS host: without SNI, Oracle's endpoint
        # cannot select the right certificate and the handshake fails.
        proxy_ssl_server_name on;

        proxy_read_timeout 60s;
        client_max_body_size 64k;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The key is a credential: keep it out of this container's logs too.
        access_log off;
    }

    # ---- AI assistant --------------------------------------------------
    # The chat proxy runs inside this container on 127.0.0.1:5001, holding
    # the OCI credentials so the browser never does -- same reasoning as the
    # ORDS api_key above.
    #
    # A literal address, not a hostname, on purpose: nginx resolves hostname
    # upstreams at config-parse time and refuses to start if one does not
    # resolve. That killed this container once already. With 127.0.0.1 a
    # proxy that failed to start is a 502 on /api/chat while the rest of the
    # site keeps serving.
    location /api/chat {
        proxy_pass http://127.0.0.1:5001/chat;
        proxy_set_header Host $host;
        # Generative calls are slow; matches the 240s read timeout the OCI
        # sample uses. Anything shorter cuts off legitimate responses.
        proxy_read_timeout 240s;
        client_max_body_size 32k;
    }

    # Answer review sits in front of the Next button, so a person is waiting
    # on it with nothing else to do. A much shorter timeout than /api/chat on
    # purpose: the front end falls back to its own check when the reviewer
    # does not answer in time, and waiting four minutes to be told nothing
    # would be worse than deciding locally in eight seconds.
    # Coaching for whoever is running the intake. Generous timeout: a
    # person asked a question and is reading the answer when it lands, so
    # waiting is expected here in a way it is not on the Next button.
    location /api/explain {
        proxy_pass http://127.0.0.1:5001/explain;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
        client_max_body_size 16k;
    }

    # Reading a client's whole spreadsheet: a large upload in, a long model
    # call, and a person who has just clicked Upload and expects to wait.
    # Generous on both size and time for that reason, and the only route here
    # that accepts a body worth megabytes.
    location /api/import {
        proxy_pass http://127.0.0.1:5001/import;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        proxy_request_buffering on;
        client_max_body_size 16m;
    }

    location /api/review {
        proxy_pass http://127.0.0.1:5001/review;
        proxy_set_header Host $host;
        proxy_read_timeout 8s;
        proxy_connect_timeout 2s;
        client_max_body_size 16k;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
