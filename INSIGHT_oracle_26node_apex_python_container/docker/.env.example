# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored -- never commit real passwords.

# SYS/SYSTEM password for the local Oracle Free container.
ORACLE_PASSWORD=change_me_sys_password

# Password for the iteria_ai application schema user (created automatically
# on first boot via the APP_USER/APP_USER_PASSWORD env vars).
APP_USER_PASSWORD=change_me_app_password

# --- chat-proxy (AI Follow-Up chat -> OCI Generative AI) ---
# The actual credential is NOT an env var -- it's the OCI config file/key
# mounted from OCI_CONFIG_DIR below (default ~/.oci). These three are
# non-secret identifiers, safe to put in a real .env:
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=
OCI_GENAI_MODEL_ID=
# Optional -- only needed if your model isn't in the default us-chicago-1 region:
OCI_GENAI_ENDPOINT=
# Where your real ~/.oci/config + private key live on this machine (see
# ../INSIGHT_README.md for how to generate one). Only override if it's
# somewhere other than the default.
OCI_CONFIG_DIR=~/.oci
