# Secrets / local env
docker/.env
.env
*.env.local

# Oracle wallets -- never commit these (contain TLS client certs + creds)
Wallet_*/
*wallet*/
cwallet.sso
ewallet.p12
ewallet.pem
keystore.jks
truststore.jks
ojdbc.properties
sqlnet.ora
tnsnames.ora

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node (web/tests) -- package-lock.json IS committed, node_modules is not
node_modules/

# Docker volume data if ever bind-mounted locally
docker/oradata/

# Full ADMIN/ORDS export of the target database. Such an export describes
# the whole shared workspace, not just INSIGHT, so it is kept as a local
# reference rather than committed here.
sql/ADMIN_reference_export.sql

# OS / editor cruft
.DS_Store
.idea/
.vscode/
